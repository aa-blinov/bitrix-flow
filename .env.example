# Create .env.local from this file and fill in values from your Bitrix24 app.
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_APP_URL=http://localhost:3000
BITRIX24_REDIRECT_URI=http://localhost:3000/api/oauth

# Local development. Docker Compose creates an authenticated internal MongoDB
# connection for the app container. Use a unique random password in production.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=bitrix_kanban

# The root account of the Mongo container.
MONGO_USERNAME=bitrix_app
MONGO_PASSWORD=

# The account the app itself authenticates with, created on first start from
# the two values above. Compose refuses to start when either is unset, and the
# name must differ from the root account.
MONGO_APP_USERNAME=bitrix_app
MONGO_APP_PASSWORD=

# DuckDNS token for the Caddy reverse proxy TLS challenge. Required in production
# deployments; ignored locally. Generate one at https://www.duckdns.org/ and copy
# it into .env.local.
DUCKDNS_TOKEN=

# Required for the application login. Generate unique values for each deployment.
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SESSION_SECRET=

# Sentry: без DSN отчёты об ошибках выключены. Токен нужен только для загрузки
# source maps при сборке.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Недельная сводка в чат Битрикса (просрочки по проектам и людям). Выключена, пока не задан
# DIGEST_DIALOG_ID: число для личного чата, chat<число> для группы. День недели 0-6
# (1 = понедельник) и час считаются по часовому поясу контейнера: задай TZ.
DIGEST_DIALOG_ID=
DIGEST_WEEKDAY=1
DIGEST_HOUR=9
TZ=Europe/Moscow
# Другие каналы той же сводки, каждый включается своими ключами. Telegram: токен бота от
# @BotFather и номер чата. Вебхук: любой https-адрес, получает {"text": "..."}. Почта: SMTP_URL
# вида smtps://логин:пароль@хост:465, кому и от кого.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_WEBHOOK_URL=
SMTP_URL=
DIGEST_EMAIL_TO=
DIGEST_EMAIL_FROM=
