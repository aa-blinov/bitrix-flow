{
  "name": "bitrix-kanban",
  "version": "0.5.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:contrast": "node scripts/check-palette-contrast.mjs",
    "check:utilities": "node scripts/check-utilities.mjs",
    "test:watch": "vitest",
    "test:ui": "node scripts/seed-test-db.mjs && playwright test",
    "test:ui:update": "node scripts/seed-test-db.mjs && playwright test --update-snapshots",
    "test:ui:db": "docker compose -f docker-compose.test.yml up -d",
    "screenshots": "./scripts/screenshots-docker.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monos/ui": "github:aa-blinov/monos-ui",
    "@sentry/nextjs": "^11.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "nodemailer": "^10.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
