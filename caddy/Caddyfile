{
    email admin@bitrix-flow.duckdns.org
    admin off
}

bitrix-flow.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    @events path /api/events
    handle @events {
        reverse_proxy 172.32.10.3:3000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy 172.32.10.3:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        encode gzip zstd
    }

    # Базовая защита прокси: HSTS, запрет угадывания типов и утечки реферера,
    # встраивание — только в собственный домен и порталы Битрикс24.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "frame-ancestors 'self' https://*.bitrix24.ru https://*.bitrix24.com; object-src 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }
}

# cast-team's own daemon — same DuckDNS account/Caddy instance, different
# project (~/pet/cast-team). Reaches cast-server via the cast-team_default
# network this caddy service also joined (see docker-compose.yml).
cast-team.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    reverse_proxy cast-server:1337 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    encode gzip zstd
}

# paratrack — time tracker (~/pet/paratrack). Binary runs as the
# `paratrack` container on bitrix-kanban_default; SQLite lives in the
# /home/ubuntu/paratrack-data bind mount.
paratrack.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    reverse_proxy paratrack:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}


# paratrack on the petzy.duckdns.org domain — same app container.
petzy.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }
    reverse_proxy paratrack:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}

# cast-agent — the host's own cast daemon (`cast server --port 1337`, not a
# container), reached through this network's gateway. Voice input in the web
# UI needs HTTPS: browsers only open the microphone on a secure origin.
cast-agent.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    reverse_proxy 172.32.10.1:1337 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
