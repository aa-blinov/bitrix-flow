{
    email admin@bitrix-flow.duckdns.org
    admin off
}

bitrix-flow.duckdns.org {
    tls {
        dns duckdns {env.DUCKDNS_TOKEN}
    }

    @events path /api/events
    handle @events {
        reverse_proxy app:3000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        reverse_proxy app:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        encode gzip zstd
    }
}
