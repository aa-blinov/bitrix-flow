  "narrative": {
    "northStar": "Диспетчерский пульт",
    "overview": "BitrixFlow смотрит на работу команды так, как диспетчер смотрит на пульт: поверхность спокойная и почти бесцветная, чтобы любой сигнал на ней был виден сразу. Просрочка, перегруз, стадия, приоритет: только они получают цвет. Всё остальное сделано из чернил, бумаги и тонких линий.",
    "keyCharacteristics": [
      "Монохромная база, цвет несёт только смысл",
      "Плоские поверхности, глубина за счёт тона, а не теней",
      "Плотная, сканируемая типографика на одном Inter",
      "Мягкие углы 10px на всём, пилюли только у бейджей",
      "Обе темы первого класса"
    ],
    "rules": [
      {
        "name": "The Signal Only Rule",
        "body": "Цвет на экране означает состояние. Если элемент цветной, у пользователя должен быть ответ на вопрос «что это значит»; декоративного цвета нет.",
        "section": "colors"
      },
      {
        "name": "The Tint Not Fill Rule",
        "body": "Сигналы подаются тинтом 10–20% с насыщенным текстом, а не сплошной заливкой. Сплошная заливка остаётся только у Графита.",
        "section": "colors"
      },
      {
        "name": "The 14px Floor Rule",
        "body": "Всё, что читают, а не сканируют, набрано от 14px. 12px и 10px только для меток и метаданных.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "В покое у карточек нет ни тени, ни видимой границы. Граница и shadow-sm появляются только в ответ на hover или перетаскивание.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do держать цвет за состоянием: стадия, приоритет, тег, просрочка, перегруз.",
      "Do подавать сигналы тинтом 500/20 с текстом 800 (светлая) и 300 (тёмная).",
      "Do проверять каждый экран в обеих темах.",
      "Do держать тихий текст не светлее oklch(0.53 0 0) на белом ради AA.",
      "Do оставлять крупные тач-цели ниже sm (40px)."
    ],
    "donts": [
      "Don't заливать сигналы сплошным насыщенным цветом, кроме Графита.",
      "Don't вешать тени на карточки и колонки в покое.",
      "Don't опускать читаемый текст ниже 14px; 10px только для Micro-меток в карточках.",
      "Don't вводить вторую гарнитуру без явного решения."
    ]
  }
